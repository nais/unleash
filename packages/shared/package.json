    "test": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.8.0",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "log4js": "^6.9.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3"
  }
